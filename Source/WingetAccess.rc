#include <winres.h>
#include "Version.h"

#include "HelpResources.h"

// Application manifest (asInvoker, per-monitor DPI, comctl v6).
1 RT_MANIFEST "WingetAccess.manifest"

// Manual (F1) and changelog (Ctrl+F1), carried inside the portable exe.
IDR_MANUAL_EN    RCDATA "../help/Manual_en.html"
IDR_MANUAL_FR    RCDATA "../help/Manual_fr.html"
IDR_CHANGELOG_EN RCDATA "../help/Changelog_en.html"
IDR_CHANGELOG_FR RCDATA "../help/Changelog_fr.html"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION WINGETACCESS_VERSION_RC
 PRODUCTVERSION WINGETACCESS_VERSION_RC
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040c04b0"
        BEGIN
            VALUE "CompanyName", "ReaperAccessible"
            VALUE "FileDescription", "WingetAccess - gestionnaire Winget accessible"
            VALUE "FileVersion", WINGETACCESS_VERSION_STR
            VALUE "InternalName", "WingetAccess"
            VALUE "OriginalFilename", "WingetAccess.exe"
            VALUE "ProductName", "WingetAccess"
            VALUE "ProductVersion", WINGETACCESS_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x40c, 1200
    END
END
